# Serveur Plex
PLEX_URL=https://your-plex-server.example.com:32400
PLEX_TOKEN=your-plex-token-here
# ID de la bibliothèque musique (voir /library/sections)
PLEX_SECTION_ID=5
# Filtre l'historique sur ce compte Plex (1 = propriétaire du serveur)
PLEX_ACCOUNT_ID=1

# Port de l'app
PORT=3100

# Dossiers de maps installées (séparés par ;)
BS_MAPS_DIRS=E:/BSManager/SharedContent/SharedMaps/CustomLevels
